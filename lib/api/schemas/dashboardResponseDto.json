						"amount": { "type": "number", "example": 4200.5 },
						"change": {
							"type": "number",
							"example": 12.4,
							"description": "Variação percentual vs. mês anterior"
						}
					},
					"required": ["amount", "change"],
					"x-readme-ref-name": "DashboardStatDto"
				},
				"expenses": {
					"type": "object",
					"properties": {
						"amount": { "type": "number", "example": 4200.5 },
						"change": {
							"type": "number",
							"example": 12.4,
							"description": "Variação percentual vs. mês anterior"
						}
					},
					"required": ["amount", "change"],
					"x-readme-ref-name": "DashboardStatDto"
				},
				"savings": {
					"type": "object",
					"properties": {
						"amount": { "type": "number", "example": 4200.5 },
						"change": {
							"type": "number",
							"example": 12.4,
							"description": "Variação percentual vs. mês anterior"
						}
					},
					"required": ["amount", "change"],
					"x-readme-ref-name": "DashboardStatDto"
				},
				"balance": { "type": "number", "example": 1800.25 }
			},
			"required": ["income", "expenses", "savings", "balance"],
			"x-readme-ref-name": "DashboardSummaryDto"
		},
		"expensesByCategory": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": { "type": "string", "example": "Alimentação" },
					"value": { "type": "number", "example": 540.9 },
					"color": { "type": "string", "example": "#22C55E" }
				},
				"required": ["name", "value", "color"],
				"x-readme-ref-name": "DashboardExpenseByCategoryDto"
			}
		},
		"recentTransactions": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": { "type": "string", "example": "uuid-transaction" },
					"userId": { "type": "string", "example": "uuid-user" },
					"description": { "type": "string", "example": "Supermercado" },
					"amount": {
						"type": "string",
						"example": "145.90",
						"description": "Valor decimal como string"
					},
					"date": {
						"format": "date-time",
						"type": "string",
						"example": "2026-03-31T00:00:00.000Z"
					},
					"notes": {
						"type": "string",
						"example": "Compra mensal",
						"nullable": true
					},
					"type": {
						"type": "string",
						"enum": ["GANHO", "GASTO"],
						"example": "GASTO"
					},
					"createdAt": { "format": "date-time", "type": "string" },
					"updatedAt": { "format": "date-time", "type": "string" },
					"categoryId": { "type": "string", "example": "uuid-category" },
					"tag": {
						"type": "string",
						"enum": ["FALTA", "PAGO", "DEVOLVER", "ECONOMIA", "RECEBIDO"],
						"nullable": true
					},
					"paymentMethod": {
						"type": "string",
						"enum": ["PIX", "DEBITO", "CREDITO"],
						"nullable": true
					},
					"installmentGroupId": {
						"type": "string",
						"nullable": true,
						"description": "Preenchido quando parte de um parcelamento"
					},
					"installmentIndex": { "type": "number", "nullable": true },
					"installmentCount": { "type": "number", "nullable": true },
					"category": {
						"type": "object",
						"properties": {
							"id": { "type": "string", "example": "uuid-category" },
							"userId": { "type": "string", "example": "uuid-user" },
							"name": { "type": "string", "example": "Alimentação" },
							"color": { "type": "string", "example": "#22C55E" },
							"icon": { "type": "string", "example": "food", "nullable": true },
							"isDefault": { "type": "boolean", "example": false },
							"type": {
								"type": "string",
								"enum": ["GANHO", "GASTO", "AMBOS"],
								"nullable": true
							},
							"createdAt": { "format": "date-time", "type": "string" },
							"updatedAt": { "format": "date-time", "type": "string" }
						},
						"required": [
							"id",
							"userId",
							"name",
							"color",
							"isDefault",
							"createdAt",
							"updatedAt"
						],
						"x-readme-ref-name": "CategoryResponseDto"
					}
				},
				"required": [
					"id",
					"userId",
					"description",
					"amount",
					"date",
					"type",
					"createdAt",
					"updatedAt",
					"categoryId",
					"category"
				],
				"x-readme-ref-name": "TransactionResponseDto"
			}
		},
		"budgets": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": { "type": "string", "example": "uuid-budget" },
					"category": {
						"type": "string",
						"example": "Alimentação",
						"description": "Nome da categoria"
					},
					"current": { "type": "number", "example": 320.5 },
					"max": { "type": "number", "example": 500 },
					"color": { "type": "string", "example": "#22C55E" }
				},
				"required": ["id", "category", "current", "max", "color"],
				"x-readme-ref-name": "DashboardBudgetProgressDto"
			}
		},
		"monthlyData": {
			"description": "Últimos 6 meses",
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"month": { "type": "string", "example": "mar" },
					"income": { "type": "number", "example": 4200.5 },
					"expenses": { "type": "number", "example": 2600.25 },
					"savings": { "type": "number", "example": 1600.25 }
				},
				"required": ["month", "income", "expenses", "savings"],
				"x-readme-ref-name": "DashboardMonthlyDataDto"
			}
		}
	},
	"required": [
		"summary",
		"expensesByCategory",
		"recentTransactions",
		"budgets",
		"monthlyData"
	],
	"x-readme-ref-name": "DashboardResponseDto"
}
