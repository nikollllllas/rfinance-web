# Proxy same-origin (next.config.ts): destino real da API Nest (sem barra final)
API_PROXY_TARGET=https://rfinance-api.onrender.com

# Kubb / codegen: JSON OpenAPI (ex.: https://rfinance-api.onrender.com/docs-json)
OPENAPI_SPEC_URL=https://rfinance-api.onrender.com/docs-json

# Mostra o botão "Relatório" na página de transações (true/false)
NEXT_PUBLIC_REPORTS_ENABLED=false
